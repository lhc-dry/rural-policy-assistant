{
  "name": "rural-policy-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write src *.json *.ts *.js README.md",
    "demo": "node scripts/create-demo.mjs",
    "server:dev": "tsx server/src/app.ts",
    "server:worker": "tsx server/src/worker.ts",
    "start:api": "tsx server/src/app.ts",
    "start:worker": "tsx server/src/worker.ts",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "2.17.2",
    "antd": "^5.24.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "echarts": "^5.6.0",
    "echarts-wordcloud": "^2.1.0",
    "effect": "^3.17.13",
    "fastify": "^5.2.1",
    "idb": "^8.0.2",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "msw": "^2.7.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "4.8.69",
    "pg": "^8.13.1",
    "prisma": "^6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.28.0",
    "react-window": "1.8.10",
    "wink-bm25-text-search": "3.1.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "npm:esbuild-wasm@^0.25.12",
    "eslint": "^9.16.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
